# Backend. Para desarrollo local, copie este archivo a .env.local en la raiz.
# dev.mjs carga .env.local; el archivo esta ignorado por Git. No incluya secretos en commits.
# DATABASE_URL usa el rol exclusivo de EcoPulse, no postgres; codifique caracteres especiales de la contrasena para URL.
PORT=5000
DATABASE_URL=
# Solo para migraciones: use un rol separado propietario del esquema.
MIGRATION_DATABASE_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Lista separada por comas. Para desarrollo local use exactamente este origen.
PILOT_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Política futura: enteros positivos, sin valores predeterminados. No completar ni activar sin autorización.
POINTS_PER_KG=
POINTS_MAX_PER_DELIVERY=
# Activación por etapas. Todas las acciones físicas y puntos permanecen bloqueados por defecto.
PILOT_RECEIPT_ENABLED=false
PILOT_VERIFICATION_ENABLED=false
PILOT_POINTS_ENABLED=false
# Mantenga false: canjes de recompensas desactivados hasta aprobar política y pruebas.
PILOT_REWARDS_ENABLED=false
# Borradores admin y cumplimiento/canjes requieren permisos separados; ambos desactivados.
PILOT_REWARD_ADMIN_ENABLED=false
PILOT_REWARD_FULFILLMENT_ENABLED=false
# Referencia de la política de canjes aprobada; obligatoria para activar canjes.
REWARD_POLICY_REFERENCE=
# La IA solo sugiere una categoría; sin clave y modelo de servidor permanece desactivada.
PILOT_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
# Active solicitudes detalladas solo después de aplicar 0001, conceder permisos y validar centros/horarios.
PILOT_DELIVERY_DETAILS_ENABLED=false
# Administración de borradores de centros y horarios; requiere rol admin y permisos INSERT mínimos.
PILOT_CATALOG_ADMIN_ENABLED=false
# Publicación requiere 0002, administrador asignado y evidencia validada.
PILOT_CATALOG_PUBLICATION_ENABLED=false

# Frontend. Solo la clave publicable de Clerk puede estar en VITE_*.
# Use aquí la misma clave pk_test_ configurada en CLERK_PUBLISHABLE_KEY.
VITE_CLERK_PUBLISHABLE_KEY=
# URL pública del backend local consumida por el navegador.
VITE_PILOT_API_URL=http://127.0.0.1:5000
# Déjelo vacío en desarrollo local; no se necesita proxy para la instancia Development.
VITE_CLERK_PROXY_URL=
BASE_PATH=/
