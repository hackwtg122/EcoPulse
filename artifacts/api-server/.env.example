# EcoPulse API — example environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Core ---
PORT=5001
NODE_ENV=development
DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/ecopulse_dev
# Optional isolated academic database. Requires explicit URL; never rewrites DATABASE_URL.
EVALUATION_MODE_ENABLED=false
# EVALUATION_DATABASE_URL=postgresql://eval_user:password@127.0.0.1:5432/ecopulse_eval
MIGRATION_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/ecopulse_dev

# --- Clerk ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# --- Pilot CORS ---
PILOT_ALLOWED_ORIGINS=http://127.0.0.1:5174
PILOT_CATALOG_ADMIN_ENABLED=true

# --- AI (OpenRouter) ---
# Master switch: "true" enables /scans/classify and /guide/ask.
PILOT_AI_ENABLED=true
AI_PROVIDER=openrouter
# Server-side key only. Never exposed to the browser.
AI_API_KEY=
# Optional override of the OpenRouter base URL.
# AI_BASE_URL=https://openrouter.ai/api/v1
# Verified free open models (see VERIFIED_FREE_OPEN_MODELS in aiProvider.ts).
# Vision (EcoScan): must accept image input.
AI_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Chat (EcoGuía).
AI_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Extra allowlist entries (comma-separated). They cannot admit models outside the
# built-in verified set; a non-verified entry is rejected with ai_provider_model_not_verified.
# AI_VISION_MODEL_ALLOW=
# AI_CHAT_MODEL_ALLOW=
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_MS=500
# Reasoning models consume tokens before the visible answer; keep these high.
AI_MAX_TOKENS_VISION=1000
AI_MAX_TOKENS_CHAT=2000

# --- AI quotas ---
# "file" persists counters across restarts (single-process dev).
# "memory" resets on restart (tests only).
AI_QUOTA_STORE=file
AI_QUOTA_FILE_PATH=./storage/ai_quota.json
AI_DAILY_GLOBAL_FREE_REQ=50
AI_DAILY_PER_USER_FREE_REQ=8
AI_MINUTE_PER_USER_FREE_REQ=2
AI_GUIDE_MINUTE_PER_USER_FREE_REQ=4

# --- Points / rewards ---
# Proposed academic policy, NOT active until approved: 20 points/kg of verified
# material, maximum 100 per delivery; never credit scans or estimated weight.
# POINTS_PER_KG=20
# POINTS_MAX_PER_DELIVERY=100
# REWARD_POLICY_REFERENCE=academic:ecopulse/policy-v1
PILOT_POINTS_ENABLED=
