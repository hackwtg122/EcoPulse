{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./dev.mjs",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:policy": "node --experimental-strip-types src/lib/pilotPolicy.test.mjs",
    "test:access": "node --experimental-strip-types src/lib/pilotAccessPolicy.test.mjs",
    "test:delivery-details": "node --experimental-strip-types src/lib/deliveryDetails.test.mjs",
    "test:catalog": "node --experimental-strip-types src/lib/deliveryCatalog.test.mjs",
    "test:progress": "node --experimental-strip-types src/lib/progressService.test.mjs",
    "test:ai": "node --experimental-strip-types src/lib/aiClassification.test.mjs",
    "test:guide": "node --experimental-strip-types src/lib/aiGuide.test.mjs",
    "test:reward": "node --experimental-strip-types src/lib/rewardService.test.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.54",
    "@clerk/shared": "^4.28.1",
    "@types/uuid": "^11.0.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
